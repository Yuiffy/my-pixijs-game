{
  "name": "my-pixijs-game",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.17.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:esa": "node scripts/build-esa.mjs",
    "export": "next build && next export",
    "gh-pages": "npx gh-pages -d out --dotfiles true",
    "build-export-gh-pages": "npm run export && npm run gh-pages",
    "start": "next start",
    "lint": "next lint",
    "check": "pnpm lint && pnpm exec tsc --noEmit",
    "run-sync-scripts": "node scripts/sync_streams.mjs",
    "streams:assign": "node scripts/assign-stream-shard.mjs",
    "streams:check": "node scripts/check-stream-sync-setup.mjs",
    "streams:publish": "node scripts/sync-and-push.mjs",
    "streams:verify": "node scripts/verify-stream-data.mjs --local --references-only",
    "streams:test": "node --test scripts/tests/stream-shards.test.mjs scripts/tests/sync-failures.test.mjs",
    "autochess:test": "node --test scripts/tests/autochess-*.test.mjs",
    "autochess:simulate": "node scripts/simulate-autochess-runs.mjs",
    "autochess:benchmark:autopilot": "node scripts/benchmark-autochess-autopilot.mjs",
    "autochess:benchmark:styles": "node scripts/benchmark-autochess-styles.mjs",
    "autochess:benchmark:lineups": "node scripts/benchmark-autochess-lineups.mjs",
    "autochess:benchmark:replacements": "node scripts/benchmark-autochess-replacements.mjs",
    "autochess:benchmark:training": "node scripts/train-autochess-autopilot.mjs --population 2 --generations 1 --runs 8 --battles 50 --workers 8 --training-hz 20 --skip-validation --output artifacts/autochess-training-throughput.json",
    "autochess:train:autopilot": "node scripts/train-autochess-autopilot.mjs",
    "autochess:verify:autopilot-20": "node scripts/benchmark-autochess-autopilot.mjs --runs 1 --seed 73020 --battles 21 --require-win-round 20",
    "autochess:benchmark:waves": "node scripts/benchmark-autochess-waves.mjs",
    "autochess:verify:ai": "node scripts/verify-autochess-ai.cjs",
    "autochess:verify:autoplay": "node scripts/verify-autochess-autoplay.cjs",
    "autochess:verify:release-notes": "node scripts/verify-autochess-release-notes.cjs",
    "autochess:verify:campaign-choice": "node scripts/verify-autochess-campaign-choice.cjs",
    "autochess:verify:seed-restart": "node scripts/verify-autochess-seed-restart.cjs",
    "autochess:verify:shop-details": "node scripts/verify-autochess-shop-details.cjs",
    "autochess:verify:auto-arrange": "node scripts/verify-autochess-auto-arrange.cjs",
    "autochess:verify:tiandou": "node scripts/verify-autochess-tiandou.cjs",
    "autochess:verify:youyi": "node scripts/verify-autochess-youyi.cjs",
    "wuxia:test": "node --test scripts/tests/wuxia-*.test.mjs",
    "wuxia:verify": "pnpm wuxia:test && node scripts/verify-wuxia-editions.cjs && node scripts/verify-wuxia.cjs && node scripts/verify-wuxia-martial.cjs",
    "wuxia:verify:editions": "node scripts/verify-wuxia-editions.cjs",
    "wuxia:verify:martial": "node scripts/verify-wuxia-martial.cjs",
    "autochess:release:check": "node scripts/verify-autochess-release.mjs",
    "autochess:portrait:generate": "node scripts/autochess-portrait-generate.mjs",
    "autochess:portrait:process": "node scripts/autochess-portrait-process.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs sync-livers-cron",
    "pm2:status": "pm2 status",
    "pm2:install-startup": "pm2-startup install",
    "pm2:resurrect": "pm2 resurrect",
    "pm2:save": "pm2 save"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@neondatabase/serverless": "^1.0.2",
    "@pixi/react": "^7.1.1",
    "antd": "^5.14.0",
    "dayjs": "^1.11.19",
    "matter-js": "^0.19.0",
    "next": "14.2.35",
    "phaser": "4.2.1",
    "pixi.js": "^7.4.0",
    "planck": "^1.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/matter-js": "^0.19.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
