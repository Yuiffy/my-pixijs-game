      "name": "岁己",
      "voiceName": "明媚女声",
      "lines": {
        "intro": "海风正好，一起打场漂亮的比赛吧！",
        "special": "这一球，飞到晴空去！",
        "pointWin": "好球！下一分也加油！",
        "pointLose": "没关系，下一球我会接住！",
        "victory": "赢啦！今天的海风，都是甜的！",
        "defeat": "这次输了，下次再好好比一场！"
      }
    },
    "shiori": {
      "name": "栞栞",
      "voiceName": "清润女声",
      "lines": {
        "intro": "听，海浪来了。准备好，和我一起出发吧。",
        "special": "听见了吗？海浪的声音。",
        "pointWin": "接得不错。继续跟上海浪的节奏。",
        "pointLose": "调整呼吸，下一球再来。",
        "victory": "赢下来了。谢谢你，陪我打到这一刻。",
        "defeat": "今天就到这里。下次，我们再一起打到日落。"
      }
    },
    "nagisa": {
      "name": "米汀",
      "voiceName": "清冷女主",
      "lines": {
        "intro": "场地确认完毕。让我看看，你的球路。",
        "special": "找到破绽了。看这道星光！",
        "pointWin": "这一分，拿下了。",
        "pointLose": "记住了。下一球，我会改变路线。",
        "victory": "胜负已定。和你交手，很有意思。",
        "defeat": "这次是你赢了。下次，我会找到新的答案。"
      }
    }
  },
